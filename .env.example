# Copy to .env and fill in. .env is gitignored.

# SQLite for local development. See DEPLOY.md for Postgres.
DATABASE_URL="file:./dev.db"

# serpapi.com — free tier covers a full ingest run
SERPAPI_API_KEY=""

# Optional search tuning
SERP_ENGINE="google"
SERP_LOCATION="Mumbai,Maharashtra,India"
SERP_GL="in"
SERP_HL="en"

# Local Ollama. Model must be pulled: ollama pull llama3
OLLAMA_URL="http://localhost:11434"
LLM_MODEL="llama3"

# Shared secret gating /admin
ADMIN_TOKEN=""
