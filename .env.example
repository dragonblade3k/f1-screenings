# Copy to .env and fill in. .env is gitignored.

# Postgres, same hosted database for local development and the deployment.
# Supabase project f1-screenings, ap-south-1. See DEPLOY.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection, port 5432. Used by prisma migrate, which cannot run
# through the pooler. Same database.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# serpapi.com — free tier covers a full ingest run
SERPAPI_API_KEY=""

# Optional search tuning
SERP_ENGINE="google"
SERP_LOCATION="Mumbai,Maharashtra,India"
SERP_GL="in"
SERP_HL="en"

# Local Ollama. Model must be pulled: ollama pull llama3
OLLAMA_URL="http://localhost:11434"
LLM_MODEL="llama3"

# Shared secret gating /admin. Leave unset locally only if you never open /admin.
ADMIN_TOKEN=""

# Set to 1 in the hosted environment only. Makes /admin and /api/admin 404 so
# the deployed copy serves the public read paths and nothing else. Leave unset
# locally, which is where ingestion and curation happen.
PUBLIC_ONLY=""
